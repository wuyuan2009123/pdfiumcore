<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.pdfiumcore</groupId>
    <artifactId>pdfiumcore-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>pdfiumcore</artifactId>
  <packaging>jar</packaging>

  <name>PDFiumCore</name>
  <description>
    Foreign Function &amp; Memory bindings for PDFium generated from the official header
    files, plus the native binaries for the supported platforms.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/../native/include</directory>
        <targetPath>pdfium/include</targetPath>
      </resource>
      <resource>
        <directory>${project.basedir}/../native</directory>
        <targetPath>pdfium</targetPath>
        <includes>
          <include>VERSION</include>
          <include>PDFIUM-LICENSE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>dist-win-x64</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-win-x64.xml</descriptor></descriptors>
              <finalName>pdfiumcore-${project.version}</finalName>
              <outputDirectory>${project.basedir}/../dist</outputDirectory>
              <attach>false</attach>
            </configuration>
          </execution>
          <execution>
            <id>dist-win-arm64</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-win-arm64.xml</descriptor></descriptors>
              <finalName>pdfiumcore-${project.version}</finalName>
              <outputDirectory>${project.basedir}/../dist</outputDirectory>
              <attach>false</attach>
            </configuration>
          </execution>
          <execution>
            <id>dist-linux-x64</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-linux-x64.xml</descriptor></descriptors>
              <finalName>pdfiumcore-${project.version}</finalName>
              <outputDirectory>${project.basedir}/../dist</outputDirectory>
              <attach>false</attach>
            </configuration>
          </execution>
          <execution>
            <id>dist-linux-arm64</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-linux-arm64.xml</descriptor></descriptors>
              <finalName>pdfiumcore-${project.version}</finalName>
              <outputDirectory>${project.basedir}/../dist</outputDirectory>
              <attach>false</attach>
            </configuration>
          </execution>
          <execution>
            <id>dist-macos-x64</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-macos-x64.xml</descriptor></descriptors>
              <finalName>pdfiumcore-${project.version}</finalName>
              <outputDirectory>${project.basedir}/../dist</outputDirectory>
              <attach>false</attach>
            </configuration>
          </execution>
          <execution>
            <id>dist-macos-arm64</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-macos-arm64.xml</descriptor></descriptors>
              <finalName>pdfiumcore-${project.version}</finalName>
              <outputDirectory>${project.basedir}/../dist</outputDirectory>
              <attach>false</attach>
            </configuration>
          </execution>
          <execution>
            <id>dist-all</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-all.xml</descriptor></descriptors>
              <finalName>pdfiumcore-${project.version}</finalName>
              <outputDirectory>${project.basedir}/../dist</outputDirectory>
              <attach>false</attach>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
